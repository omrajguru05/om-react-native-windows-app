{
  "name": "om-react-native-windows-app",
  "version": "1.0.0",
  "private": true,
  "description": "Om Native Desktop Companion for Windows & macOS",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "app": "electron .",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "start": "react-native start",
    "windows": "react-native run-windows",
    "macos": "react-native run-macos",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.om.desktop",
    "productName": "Om",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "public/icon.png"
    }
  },
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-macos": "0.74.15",
    "react-native-web": "^0.19.13",
    "react-native-windows": "0.74.31"
  },
  "devDependencies": {
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@types/react-native": "^0.73.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^40.8.0",
    "electron-builder": "^26.7.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
